{
  "realm": "bp",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "bp-web",
      "name": "BP Web (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-not-a-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3001/auth/callback"],
      "webOrigins": ["http://localhost:3001", "http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "bp-mobile",
      "name": "BP Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["bpapp://callback", "http://localhost:3001/*"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "bp-test",
      "name": "BP Test (direct grant, TEST-ONLY)",
      "description": "TEST-ONLY client with Resource Owner Password grant to obtain real tokens in automated tests. Do NOT enable in production.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "test-only-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Cliente",
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["customer"]
    }
  ],
  "roles": {
    "realm": [{ "name": "customer", "description": "Cliente de banca digital" }]
  }
}
