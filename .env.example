# BP Banca Digital - variables de entorno de la PoC local.
# Copiar a .env (NUNCA commitear .env). Estos valores son FICTICIOS para desarrollo local.

# API
API_PORT=3001
NODE_ENV=development
# Authentication bypass for LOCAL/HTTP testing ONLY (never in production).
DEV_AUTH_BYPASS=false
CACHE_TTL_SECONDS=60
# Shared token protecting internal operational endpoints (e.g. POST /internal/reconcile).
INTERNAL_API_TOKEN=dev-only-internal-token

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bp
POSTGRES_PASSWORD=bp
POSTGRES_DB=bp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=bp
RABBITMQ_PASSWORD=bp
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://bp:bp@localhost:5672

# Core Bancario (WireMock) y sistema complementario (WireMock)
CORE_PORT=8090
CORE_BASE_URL=http://localhost:8090
CORE_TIMEOUT_MS=2500
COMPLEMENTARY_PORT=8091
COMPLEMENTARY_BASE_URL=http://localhost:8091

# Keycloak (IdP local)
KEYCLOAK_PORT=8088
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER=http://localhost:8088/realms/bp
OIDC_CLIENT_ID=bp-web
OIDC_CLIENT_SECRET=dev-only-not-a-secret
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
OIDC_JWKS_URI=http://localhost:8088/realms/bp/protocol/openid-connect/certs

# BFF (session) - development values, not real secrets
BFF_SESSION_SECRET=dev-only-session-secret
BFF_COOKIE_NAME=bp_session
# Where the BFF redirects the browser after a successful login (the SPA origin).
BFF_POST_LOGIN_REDIRECT=http://localhost:5173/
