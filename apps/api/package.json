{
  "name": "@bp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js",
    "migration:run": "ts-node -r tsconfig-paths/register ./src/infra/database/run-migrations.ts",
    "seed": "ts-node -r tsconfig-paths/register ./src/infra/database/seed.ts",
    "lint": "echo skip"
  },
  "dependencies": {
    "@bp/contracts": "workspace:*",
    "@bp/domain": "workspace:*",
    "@bp/shared": "workspace:*",
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/terminus": "10.2.3",
    "amqplib": "0.10.4",
    "axios": "1.7.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.6",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "jose": "5.9.3",
    "pg": "8.12.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.4",
    "@types/amqplib": "0.10.5",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.4",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.5.4"
  }
}
